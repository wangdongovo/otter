{
  "name": "otter",
  "productName": "Otter",
  "version": "0.0.6",
  "description": "跨平台桌面应用",
  "main": ".vite/build/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/wangdongovo/otter.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "clean:out": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "package": "npm run clean:out && electron-forge package",
    "make": "npm run clean:out && electron-forge make",
    "package:mac-arm64": "npm run clean:out && electron-forge package --platform=darwin --arch=arm64",
    "make:mac-arm64": "npm run clean:out && electron-forge make --platform=darwin --arch=arm64",
    "make:win-x64": "npm run clean:out && electron-forge make --platform=win32 --arch=x64",
    "release:patch": "npm version patch && git push origin HEAD && git push origin v$(node -p \"require('./package.json').version\")",
    "release:minor": "npm version minor && git push origin HEAD && git push origin v$(node -p \"require('./package.json').version\")",
    "release:major": "npm version major && git push origin HEAD && git push origin v$(node -p \"require('./package.json').version\")",
    "publish": "npm run clean:out && electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": "dw",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.12",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "43.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "update-electron-app": "^3.3.0"
  }
}
